# Server
PORT=3001

# Gemini (lib/llm.ts) — primary LLM provider for now (free tier).
# Anthropic/OpenAI keys get added here when wired in as production fallback providers.
GEMINI_API_KEY=

# MongoDB (db/client.ts)
MONGODB_URI=

# Dashboard auth (routes/auth.ts, lib/session.ts) — gates every /api/* route
# except /api/auth itself and /api/whatsapp (once built). SESSION_SECRET
# should be a long random string; it signs the session cookie.
DASHBOARD_PASSWORD=
SESSION_SECRET=

# WhatsApp Cloud API (services/whatsapp.ts, routes/whatsapp.ts)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=

# Instagram Graph API (services/instagram.ts)
INSTAGRAM_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# YouTube Data API (services/youtube.ts)
YOUTUBE_API_KEY=

# Google Calendar (services/google-calendar.ts)
# Service-account JSON key — either a file path (local dev) or the raw JSON
# string (e.g. hosts with no filesystem for a key file in production).
GOOGLE_CALENDAR_CREDENTIALS=
GOOGLE_CALENDAR_ID=

# Embeddings for RAG (rag/embeddings.ts)
EMBEDDING_API_KEY=
